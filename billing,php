<?php
// Database connection
$servername = "localhost";
$username = "root";
$password = "";
$dbname = "rental";

$conn = new mysqli($servername, $username, $password, $dbname);
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

// Fetch tenant billing data
$sql = "SELECT 
            tenant.id, 
            tenant.name AS tenant_name, 
            stall.stall_name, 
            (stall.yearly_price / 12) AS monthly_rate,
            ((stall.yearly_price / 12) - IFNULL(SUM(
                CASE 
                    WHEN MONTH(payment.payment_date) = MONTH(CURDATE()) 
                    AND YEAR(payment.payment_date) = YEAR(CURDATE()) 
                    THEN payment.payment_amount ELSE 0 
                END
            ), 0)) AS monthly_balance
        FROM tenant
        JOIN stall ON tenant.stall_no_rented = stall.stall_no
        LEFT JOIN payment ON tenant.id = payment.tenant_id
        GROUP BY tenant.id";
$result = $conn->query($sql);
?>
